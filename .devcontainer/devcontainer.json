{
    "name": "gem5 Development Container",
    "image": "ghcr.io/gem5/ubuntu-24.04_all-dependencies:v25-0",
    "hostRequirements": {
        "cpus": 8,
        "memory": "16gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-vscode.cpptools",
                "Tsinghua-Hexin-Joint-Institute.gem5-slicc"
            ],
            "settings": {
                "python.analysis.extraPaths": [
                    "/workspaces/gem5-lab/tests/ucas/stubs"
                ],
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },
    "workspaceFolder": "/workspaces/gem5-lab",
    "onCreateCommand": "./.devcontainer/on-create.sh"
}
